# Test-account credentials for QAMind. Copy this file to .env.qa and fill it in.
# .env.qa is git-ignored. Use TEST accounts on a TEST environment only, never real users or production.
# The variable names below are the ones named in the "roles" table of .qa/config.md.
QA_ADMIN_USERNAME=
QA_ADMIN_PASSWORD=
QA_CLIENT_A_USERNAME=
QA_CLIENT_A_PASSWORD=
QA_CLIENT_B_USERNAME=
QA_CLIENT_B_PASSWORD=
