diff --git a/test/qa-issue-001-order-tenant.test.mjs b/test/qa-issue-001-order-tenant.test.mjs
new file mode 100644
index 0000000..7ccb11f
--- /dev/null
+++ b/test/qa-issue-001-order-tenant.test.mjs
@@ -0,0 +1,29 @@
+import assert from 'node:assert/strict';
+import { after, before, describe, it } from 'node:test';
+import { startTestApp } from './helpers.mjs';
+
+describe('order detail tenant isolation', () => {
+  let t;
+  let orderId;
+  before(async () => {
+    t = await startTestApp();
+    const created = await t.call('POST', '/api/orders', {
+      token: await t.login('acme1'),
+      body: { reference: 'QA-iso', items: [{ product_id: 'p-101', quantity: 2 }] },
+    });
+    orderId = created.json.id;
+  });
+  after(() => t.close());
+
+  it('hides another company\'s order', async () => {
+    const res = await t.call('GET', `/api/orders/${orderId}`, { token: await t.login('bright1') });
+    assert.equal(res.status, 404);
+  });
+
+  it('still shows the order to the same company and to an admin', async () => {
+    const same = await t.call('GET', `/api/orders/${orderId}`, { token: await t.login('acme2') });
+    const admin = await t.call('GET', `/api/orders/${orderId}`, { token: await t.login('admin') });
+    assert.equal(same.status, 200);
+    assert.equal(admin.status, 200);
+  });
+});
diff --git a/test/qa-issue-002-customers-admin-only.test.mjs b/test/qa-issue-002-customers-admin-only.test.mjs
new file mode 100644
index 0000000..a062ea9
--- /dev/null
+++ b/test/qa-issue-002-customers-admin-only.test.mjs
@@ -0,0 +1,25 @@
+import assert from 'node:assert/strict';
+import { after, before, describe, it } from 'node:test';
+import { startTestApp } from './helpers.mjs';
+
+describe('customer list is admin only', () => {
+  let t;
+  before(async () => { t = await startTestApp(); });
+  after(() => t.close());
+
+  it('refuses a client', async () => {
+    const res = await t.call('GET', '/api/admin/customers', { token: await t.login('acme1') });
+    assert.equal(res.status, 403);
+  });
+
+  it('refuses anonymous callers', async () => {
+    const res = await t.call('GET', '/api/admin/customers');
+    assert.equal(res.status, 401);
+  });
+
+  it('still lists customers for an admin', async () => {
+    const res = await t.call('GET', '/api/admin/customers', { token: await t.login('admin') });
+    assert.equal(res.status, 200);
+    assert.ok(res.json.items.length > 0);
+  });
+});
diff --git a/test/qa-issue-003-logout.test.mjs b/test/qa-issue-003-logout.test.mjs
new file mode 100644
index 0000000..4769afb
--- /dev/null
+++ b/test/qa-issue-003-logout.test.mjs
@@ -0,0 +1,24 @@
+import assert from 'node:assert/strict';
+import { after, before, describe, it } from 'node:test';
+import { startTestApp } from './helpers.mjs';
+
+describe('sign out ends the session', () => {
+  let t;
+  before(async () => { t = await startTestApp(); });
+  after(() => t.close());
+
+  it('refuses the old token after logout', async () => {
+    const token = await t.login('acme2');
+    assert.equal((await t.call('GET', '/api/me', { token })).status, 200);
+    assert.equal((await t.call('POST', '/api/auth/logout', { token })).status, 204);
+    const res = await t.call('GET', '/api/me', { token });
+    assert.equal(res.status, 401);
+  });
+
+  it('does not affect another session of the same user', async () => {
+    const first = await t.login('bright1');
+    const second = await t.login('bright1');
+    await t.call('POST', '/api/auth/logout', { token: first });
+    assert.equal((await t.call('GET', '/api/me', { token: second })).status, 200);
+  });
+});
diff --git a/test/qa-issue-004-tax-after-discount.test.mjs b/test/qa-issue-004-tax-after-discount.test.mjs
new file mode 100644
index 0000000..296b72f
--- /dev/null
+++ b/test/qa-issue-004-tax-after-discount.test.mjs
@@ -0,0 +1,22 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+import { priceOrder } from '../src/pricing.mjs';
+
+const products = new Map([['p-102', { id: 'p-102', name: 'Ballpoint Pens', price_cents: 1250 }]]);
+const price = (quantity) => priceOrder([{ product_id: 'p-102', quantity }], products);
+
+describe('tax is charged on the discounted subtotal', () => {
+  it('at exactly 1000.00: 1000.00 - 50.00 + 95.00 = 1045.00', () => {
+    const order = price(80);
+    assert.equal(order.subtotal_cents, 100000);
+    assert.equal(order.discount_cents, 5000);
+    assert.equal(order.tax_cents, 9500);
+    assert.equal(order.total_cents, 104500);
+  });
+
+  it('just below the threshold there is no discount: 987.50 + 98.75 = 1086.25', () => {
+    const order = price(79);
+    assert.equal(order.discount_cents, 0);
+    assert.equal(order.total_cents, 108625);
+  });
+});
diff --git a/test/qa-issue-005-order-quantity.test.mjs b/test/qa-issue-005-order-quantity.test.mjs
new file mode 100644
index 0000000..cbd5760
--- /dev/null
+++ b/test/qa-issue-005-order-quantity.test.mjs
@@ -0,0 +1,32 @@
+import assert from 'node:assert/strict';
+import { after, before, describe, it } from 'node:test';
+import { startTestApp } from './helpers.mjs';
+
+describe('order quantity and items validation', () => {
+  let t;
+  let token;
+  before(async () => {
+    t = await startTestApp();
+    token = await t.login('acme1');
+  });
+  after(() => t.close());
+
+  const place = (items) => t.call('POST', '/api/orders', { token, body: { reference: 'QA-qty', items } });
+
+  for (const quantity of [-3, 0, 1001, 1.5]) {
+    it(`refuses quantity ${quantity}`, async () => {
+      const res = await place([{ product_id: 'p-101', quantity }]);
+      assert.equal(res.status, 400);
+    });
+  }
+
+  it('refuses an order with no items', async () => {
+    const res = await place([]);
+    assert.equal(res.status, 400);
+  });
+
+  it('accepts the boundaries 1 and 1000', async () => {
+    assert.equal((await place([{ product_id: 'p-101', quantity: 1 }])).status, 201);
+    assert.equal((await place([{ product_id: 'p-101', quantity: 1000 }])).status, 201);
+  });
+});