+++ b/test/qa-006-status-change-visible-in-list.test.mjs
@@ -0,0 +1,36 @@
+import assert from 'node:assert/strict';
+import { after, before, describe, it } from 'node:test';
+import { startTestApp } from './helpers.mjs';
+
+describe('status change shows in the client order list at once (ISSUE-006)', () => {
+  let t;
+  before(async () => { t = await startTestApp(); });
+  after(() => t.close());
+
+  const statusInList = async (account, id) => {
+    const res = await t.call('GET', '/api/orders?page_size=100', { token: await t.login(account) });
+    return res.json.items.find((order) => order.id === id).status;
+  };
+
+  it('shows the new status to the whole company after the list was loaded', async () => {
+    // o-1004 is a placed Acme order. Warm the cache as the viewing roles first.
+    assert.equal(await statusInList('acme1', 'o-1004'), 'placed');
+    assert.equal(await statusInList('acme2', 'o-1004'), 'placed');
+    const change = await t.call('PATCH', '/api/admin/orders/o-1004/status', {
+      token: await t.login('admin'),
+      body: { status: 'processing' },
+    });
+    assert.equal(change.status, 200);
+    assert.equal(await statusInList('acme1', 'o-1004'), 'processing');
+    assert.equal(await statusInList('acme2', 'o-1004'), 'processing');
+    const detail = await t.call('GET', '/api/orders/o-1004', { token: await t.login('acme1') });
+    assert.equal(detail.json.status, 'processing');
+  });
+
+  it('does not disturb another company\'s list', async () => {
+    assert.equal(await statusInList('bright1', 'o-1008'), 'placed');
+    await t.call('PATCH', '/api/admin/orders/o-1008/status', { token: await t.login('admin'), body: { status: 'processing' } });
+    assert.equal(await statusInList('bright1', 'o-1008'), 'processing');
+    assert.equal(await statusInList('acme1', 'o-1004'), 'processing');
+  });
+});
diff --git a/test/qa-007-order-search-literal.test.mjs b/test/qa-007-order-search-literal.test.mjs
new file mode 100644
index 0000000..4ca6ded
--- /dev/null
+++ b/test/qa-007-order-search-literal.test.mjs
@@ -0,0 +1,47 @@
+import assert from 'node:assert/strict';
+import { after, before, describe, it } from 'node:test';
+import { startTestApp } from './helpers.mjs';
+
+describe('order search treats the text literally (ISSUE-007)', () => {
+  let t;
+  let token;
+  before(async () => {
+    t = await startTestApp();
+    token = await t.login('admin');
+  });
+  after(() => t.close());
+
+  const search = (q) => t.call('GET', `/api/orders?q=${encodeURIComponent(q)}`, { token });
+
+  for (const q of ['(', '\\', '[', '*', '+', '?']) {
+    it(`answers 200 with no rows for ${JSON.stringify(q)}`, async () => {
+      const res = await search(q);
+      assert.equal(res.status, 200);
+      assert.equal(res.json.total, 0);
+    });
+  }
+
+  it('does not treat the text as a pattern', async () => {
+    assert.equal((await search('BF-.*')).json.total, 0);
+  });
+
+  it('still finds orders by reference and note, ignoring case', async () => {
+    const byReference = await search('bf-22');
+    assert.ok(byReference.json.total >= 3);
+    assert.ok(byReference.json.items.every((order) => order.reference.startsWith('BF-22')));
+    const byNote = await search('LOADING DOCK');
+    assert.equal(byNote.json.total, 1);
+    assert.equal(byNote.json.items[0].id, 'o-1001');
+  });
+
+  it('finds a reference that contains punctuation', async () => {
+    const created = await t.call('POST', '/api/orders', {
+      token: await t.login('acme1'),
+      body: { reference: 'QA-(x)+y', items: [{ product_id: 'p-101', quantity: 1 }] },
+    });
+    assert.equal(created.status, 201);
+    const found = await search('(x)+y');
+    assert.equal(found.status, 200);
+    assert.equal(found.json.total, 1);
+  });
+});
