diff --git a/test/qa-001-order-isolation.test.mjs b/test/qa-001-order-isolation.test.mjs
new file mode 100644
index 0000000..cbaf41c
--- /dev/null
+++ b/test/qa-001-order-isolation.test.mjs
@@ -0,0 +1,36 @@
+import assert from 'node:assert/strict';
+import { after, before, describe, it } from 'node:test';
+import { startTestApp } from './helpers.mjs';
+
+describe('order detail isolation between companies (ISSUE-001)', () => {
+  let t;
+  before(async () => { t = await startTestApp(); });
+  after(() => t.close());
+
+  it('hides another company\'s order from a client', async () => {
+    // o-1006 belongs to Bright Foods.
+    const acme = await t.call('GET', '/api/orders/o-1006', { token: await t.login('acme1') });
+    assert.equal(acme.status, 404);
+    const zain = await t.call('GET', '/api/orders/o-1006', { token: await t.login('zain1') });
+    assert.equal(zain.status, 404);
+  });
+
+  it('hides a freshly placed order from clients of other companies', async () => {
+    const created = await t.call('POST', '/api/orders', {
+      token: await t.login('acme1'),
+      body: { reference: 'QA-tenant', items: [{ product_id: 'p-101', quantity: 2 }] },
+    });
+    assert.equal(created.status, 201);
+    const bright = await t.call('GET', `/api/orders/${created.json.id}`, { token: await t.login('bright1') });
+    assert.equal(bright.status, 404);
+  });
+
+  it('still shows an order to its own company and to admins', async () => {
+    const own = await t.call('GET', '/api/orders/o-1001', { token: await t.login('acme1') });
+    assert.equal(own.status, 200);
+    const colleague = await t.call('GET', '/api/orders/o-1001', { token: await t.login('acme2') });
+    assert.equal(colleague.status, 200);
+    const admin = await t.call('GET', '/api/orders/o-1006', { token: await t.login('admin') });
+    assert.equal(admin.status, 200);
+  });
+});
diff --git a/test/qa-002-customers-admin-only.test.mjs b/test/qa-002-customers-admin-only.test.mjs
new file mode 100644
index 0000000..e61aa55
--- /dev/null
+++ b/test/qa-002-customers-admin-only.test.mjs
@@ -0,0 +1,24 @@
+import assert from 'node:assert/strict';
+import { after, before, describe, it } from 'node:test';
+import { startTestApp } from './helpers.mjs';
+
+describe('customer list is admin-only (ISSUE-002)', () => {
+  let t;
+  before(async () => { t = await startTestApp(); });
+  after(() => t.close());
+
+  it('refuses every client role with 403 and no customer data', async () => {
+    for (const account of ['acme1', 'acme2', 'bright1', 'zain1']) {
+      const res = await t.call('GET', '/api/admin/customers', { token: await t.login(account) });
+      assert.equal(res.status, 403, account);
+      assert.equal(res.json.error.code, 'forbidden', account);
+      assert.equal(res.json.items, undefined, account);
+    }
+  });
+
+  it('still serves the list to an admin', async () => {
+    const res = await t.call('GET', '/api/admin/customers', { token: await t.login('admin') });
+    assert.equal(res.status, 200);
+    assert.equal(res.json.items.length, 3);
+  });
+});
diff --git a/test/qa-003-logout-revokes-session.test.mjs b/test/qa-003-logout-revokes-session.test.mjs
new file mode 100644
index 0000000..6cc8560
--- /dev/null
+++ b/test/qa-003-logout-revokes-session.test.mjs
@@ -0,0 +1,26 @@
+import assert from 'node:assert/strict';
+import { after, before, describe, it } from 'node:test';
+import { startTestApp } from './helpers.mjs';
+
+describe('signing out ends the session at once (ISSUE-003)', () => {
+  let t;
+  before(async () => { t = await startTestApp(); });
+  after(() => t.close());
+
+  it('refuses the same token on every endpoint after logout', async () => {
+    const token = await t.login('zain1');
+    assert.equal((await t.call('GET', '/api/me', { token })).status, 200);
+    assert.equal((await t.call('POST', '/api/auth/logout', { token })).status, 204);
+    assert.equal((await t.call('GET', '/api/me', { token })).status, 401);
+    assert.equal((await t.call('GET', '/api/orders', { token })).status, 401);
+    assert.equal((await t.call('POST', '/api/auth/logout', { token })).status, 401);
+  });
+
+  it('keeps other sessions of the same user signed in', async () => {
+    const first = await t.login('acme1');
+    const second = await t.login('acme1');
+    assert.equal((await t.call('POST', '/api/auth/logout', { token: first })).status, 204);
+    assert.equal((await t.call('GET', '/api/me', { token: first })).status, 401);
+    assert.equal((await t.call('GET', '/api/me', { token: second })).status, 200);
+  });
+});
diff --git a/test/qa-004-tax-after-discount.test.mjs b/test/qa-004-tax-after-discount.test.mjs
new file mode 100644
index 0000000..0d2b712
--- /dev/null
+++ b/test/qa-004-tax-after-discount.test.mjs
@@ -0,0 +1,48 @@
+import assert from 'node:assert/strict';
+import { after, before, describe, it } from 'node:test';
+import { priceOrder } from '../src/pricing.mjs';
+import { startTestApp } from './helpers.mjs';
+
+const products = new Map([['p-102', { id: 'p-102', name: 'Ballpoint Pens, box of 50', price_cents: 1250 }]]);
+const price = (quantity) => priceOrder([{ product_id: 'p-102', quantity }], products);
+
+describe('tax is charged on the discounted subtotal (ISSUE-004)', () => {
+  it('discounts then taxes an order of exactly 1000.00', () => {
+    const order = price(80);
+    assert.equal(order.subtotal_cents, 100000);
+    assert.equal(order.discount_cents, 5000);
+    assert.equal(order.tax_cents, 9500);
+    assert.equal(order.total_cents, 104500);
+  });
+
+  it('discounts then taxes an order of 2000.00', () => {
+    const order = price(160);
+    assert.equal(order.discount_cents, 10000);
+    assert.equal(order.tax_cents, 19000);
+    assert.equal(order.total_cents, 209000);
+  });
+
+  it('leaves an order below the threshold untouched', () => {
+    const order = price(79);
+    assert.equal(order.subtotal_cents, 98750);
+    assert.equal(order.discount_cents, 0);
+    assert.equal(order.tax_cents, 9875);
+    assert.equal(order.total_cents, 108625);
+  });
+
+  describe('through the API', () => {
+    let t;
+    before(async () => { t = await startTestApp(); });
+    after(() => t.close());
+
+    it('stores the corrected totals', async () => {
+      const res = await t.call('POST', '/api/orders', {
+        token: await t.login('acme1'),
+        body: { reference: 'QA-at', items: [{ product_id: 'p-102', quantity: 80 }] },
+      });
+      assert.equal(res.status, 201);
+      assert.equal(res.json.tax_cents, 9500);
+      assert.equal(res.json.total_cents, 104500);
+    });
+  });
+});
diff --git a/test/qa-005-order-quantity-validation.test.mjs b/test/qa-005-order-quantity-validation.test.mjs
new file mode 100644
index 0000000..4e61ae1
--- /dev/null
+++ b/test/qa-005-order-quantity-validation.test.mjs
@@ -0,0 +1,42 @@
+import assert from 'node:assert/strict';
+import { after, before, describe, it } from 'node:test';
+import { startTestApp } from './helpers.mjs';
+
+describe('order quantity and items validation (ISSUE-005)', () => {
+  let t;
+  let token;
+  before(async () => {
+    t = await startTestApp();
+    token = await t.login('acme1');
+  });
+  after(() => t.close());
+
+  const place = (items) => t.call('POST', '/api/orders', { token, body: { reference: 'QA-qty', items } });
+  const orderCount = async () => (await t.call('GET', '/api/orders?page_size=100', { token })).json.total;
+
+  for (const quantity of [-3, 0, 1.5, 1001]) {
+    it(`refuses quantity ${quantity} and stores no order`, async () => {
+      const before = await orderCount();
+      const res = await place([{ product_id: 'p-101', quantity }]);
+      assert.equal(res.status, 400);
+      assert.equal(res.json.error.code, 'validation_error');
+      assert.equal(res.json.error.details[0].field, 'items[0].quantity');
+      assert.equal(await orderCount(), before);
+    });
+  }
+
+  it('refuses an order with no items', async () => {
+    const before = await orderCount();
+    const res = await place([]);
+    assert.equal(res.status, 400);
+    assert.equal(res.json.error.details[0].field, 'items');
+    assert.equal(await orderCount(), before);
+  });
+
+  it('accepts the boundaries 1 and 1000', async () => {
+    assert.equal((await place([{ product_id: 'p-101', quantity: 1 }])).status, 201);
+    const max = await place([{ product_id: 'p-101', quantity: 1000 }]);
+    assert.equal(max.status, 201);
+    assert.equal(max.json.items[0].quantity, 1000);
+  });
+});
diff --git a/test/qa-006-status-change-visible-in-list.test.mjs b/test/qa-006-status-change-visible-in-list.test.mjs
