diff --git a/test/qa-issue-005-logout.test.mjs b/test/qa-issue-005-logout.test.mjs
new file mode 100644
index 0000000..e933fa3
--- /dev/null
+++ b/test/qa-issue-005-logout.test.mjs
@@ -0,0 +1,24 @@
+import assert from 'node:assert/strict';
+import { after, before, describe, it } from 'node:test';
+import { startTestApp } from './helpers.mjs';
+
+describe('QA ISSUE-005: signing out ends the session', () => {
+  let t;
+  before(async () => { t = await startTestApp(); });
+  after(() => t.close());
+
+  it('rejects the token after logout', async () => {
+    const token = await t.login('bright1');
+    assert.equal((await t.call('GET', '/api/me', { token })).status, 200);
+    assert.equal((await t.call('POST', '/api/auth/logout', { token })).status, 204);
+    assert.equal((await t.call('GET', '/api/me', { token })).status, 401);
+    assert.equal((await t.call('GET', '/api/orders', { token })).status, 401);
+  });
+
+  it('does not end other sessions of the same user', async () => {
+    const first = await t.login('acme1');
+    const second = await t.login('acme1');
+    await t.call('POST', '/api/auth/logout', { token: first });
+    assert.equal((await t.call('GET', '/api/me', { token: second })).status, 200);
+  });
+});
diff --git a/test/qa-issue-006-status-cache.test.mjs b/test/qa-issue-006-status-cache.test.mjs
new file mode 100644
index 0000000..903a30d
--- /dev/null
+++ b/test/qa-issue-006-status-cache.test.mjs
@@ -0,0 +1,37 @@
+import assert from 'node:assert/strict';
+import { after, before, describe, it } from 'node:test';
+import { startTestApp } from './helpers.mjs';
+
+describe('QA ISSUE-006: a client sees a status change after an admin makes it', () => {
+  let t;
+  before(async () => { t = await startTestApp(); });
+  after(() => t.close());
+
+  it('shows the new status in the client list and detail after the list was already loaded', async () => {
+    const acme1 = await t.login('acme1');
+    const acme2 = await t.login('acme2');
+    const admin = await t.login('admin');
+    const created = await t.call('POST', '/api/orders', {
+      token: acme1,
+      body: { reference: 'QA-stale', items: [{ product_id: 'p-101', quantity: 1 }] },
+    });
+    const id = created.json.id;
+
+    const before = await t.call('GET', '/api/orders?q=QA-stale', { token: acme2 });
+    assert.equal(before.json.items[0].status, 'placed');
+
+    const patch = await t.call('PATCH', `/api/admin/orders/${id}/status`, { token: admin, body: { status: 'processing' } });
+    assert.equal(patch.status, 200);
+
+    const after = await t.call('GET', '/api/orders?q=QA-stale', { token: acme2 });
+    assert.equal(after.json.items[0].status, 'processing');
+    const detail = await t.call('GET', `/api/orders/${id}`, { token: acme2 });
+    assert.equal(detail.json.status, 'processing');
+  });
+
+  it('leaves another company\'s list unaffected', async () => {
+    const res = await t.call('GET', '/api/orders', { token: await t.login('bright1') });
+    assert.equal(res.status, 200);
+    assert.ok(res.json.items.every((order) => order.client_id === 'c-bright'));
+  });
+});
diff --git a/test/qa-issue-007-search.test.mjs b/test/qa-issue-007-search.test.mjs
