+++ b/test/qa-issue-007-search.test.mjs
@@ -0,0 +1,35 @@
+import assert from 'node:assert/strict';
+import { after, before, describe, it } from 'node:test';
+import { startTestApp } from './helpers.mjs';
+
+describe('QA ISSUE-007: order search treats the text literally', () => {
+  let t;
+  let admin;
+  before(async () => {
+    t = await startTestApp();
+    admin = await t.login('admin');
+    await t.call('POST', '/api/orders', {
+      token: await t.login('acme1'),
+      body: { reference: 'QA-search (A*B)', items: [{ product_id: 'p-101', quantity: 1 }] },
+    });
+  });
+  after(() => t.close());
+
+  for (const q of ['(', '*', '[', '\\']) {
+    it(`does not fail for q=${q}`, async () => {
+      const res = await t.call('GET', `/api/orders?q=${encodeURIComponent(q)}`, { token: admin });
+      assert.equal(res.status, 200);
+    });
+  }
+
+  it('finds an order by its literal punctuation, ignoring case', async () => {
+    const res = await t.call('GET', `/api/orders?q=${encodeURIComponent('qa-search (a*b)')}`, { token: admin });
+    assert.equal(res.status, 200);
+    assert.equal(res.json.total, 1);
+  });
+
+  it('does not treat . as a wildcard', async () => {
+    const res = await t.call('GET', `/api/orders?q=${encodeURIComponent('QA.search')}`, { token: admin });
+    assert.equal(res.json.total, 0);
+  });
+});
