diff --git a/test/qa-issue-001-pricing.test.mjs b/test/qa-issue-001-pricing.test.mjs
new file mode 100644
index 0000000..199b365
--- /dev/null
+++ b/test/qa-issue-001-pricing.test.mjs
@@ -0,0 +1,39 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+import { priceOrder } from '../src/pricing.mjs';
+import { startTestApp } from './helpers.mjs';
+
+const products = new Map([['p-102', { id: 'p-102', name: 'Pens', price_cents: 1250 }]]);
+
+describe('QA ISSUE-001: tax is applied to the discounted subtotal', () => {
+  it('taxes 950.00 for a 1,000.00 order (total 1,045.00)', () => {
+    const priced = priceOrder([{ product_id: 'p-102', quantity: 80 }], products);
+    assert.equal(priced.subtotal_cents, 100000);
+    assert.equal(priced.discount_cents, 5000);
+    assert.equal(priced.tax_cents, 9500);
+    assert.equal(priced.total_cents, 104500);
+  });
+
+  it('returns the corrected total from POST /api/orders', async () => {
+    const t = await startTestApp();
+    try {
+      const res = await t.call('POST', '/api/orders', {
+        token: await t.login('acme1'),
+        body: { reference: 'QA-thresh', items: [{ product_id: 'p-102', quantity: 80 }] },
+      });
+      assert.equal(res.status, 201);
+      assert.equal(res.json.discount_cents, 5000);
+      assert.equal(res.json.tax_cents, 9500);
+      assert.equal(res.json.total_cents, 104500);
+    } finally {
+      await t.close();
+    }
+  });
+
+  it('keeps tax on the full subtotal below the threshold', () => {
+    const priced = priceOrder([{ product_id: 'p-102', quantity: 79 }], products);
+    assert.equal(priced.discount_cents, 0);
+    assert.equal(priced.tax_cents, 9875);
+    assert.equal(priced.total_cents, 108625);
+  });
+});
diff --git a/test/qa-issue-002-quantity.test.mjs b/test/qa-issue-002-quantity.test.mjs
new file mode 100644
index 0000000..7e45dea
--- /dev/null
+++ b/test/qa-issue-002-quantity.test.mjs
@@ -0,0 +1,33 @@
+import assert from 'node:assert/strict';
+import { after, before, describe, it } from 'node:test';
+import { startTestApp } from './helpers.mjs';
+
+describe('QA ISSUE-002: order input rules are enforced', () => {
+  let t;
+  let token;
+  before(async () => {
+    t = await startTestApp();
+    token = await t.login('acme1');
+  });
+  after(() => t.close());
+
+  const place = (items) => t.call('POST', '/api/orders', { token, body: { reference: 'QA-qty', items } });
+
+  for (const quantity of [-3, 0, 1001, 1.5]) {
+    it(`refuses quantity ${quantity}`, async () => {
+      const res = await place([{ product_id: 'p-101', quantity }]);
+      assert.equal(res.status, 400);
+      assert.equal(res.json.error.code ?? res.json.code, 'validation_error');
+    });
+  }
+
+  it('refuses an order with no items', async () => {
+    const res = await place([]);
+    assert.equal(res.status, 400);
+  });
+
+  it('accepts the boundary quantities 1 and 1000', async () => {
+    assert.equal((await place([{ product_id: 'p-101', quantity: 1 }])).status, 201);
+    assert.equal((await place([{ product_id: 'p-101', quantity: 1000 }])).status, 201);
+  });
+});
diff --git a/test/qa-issue-003-order-isolation.test.mjs b/test/qa-issue-003-order-isolation.test.mjs
new file mode 100644
index 0000000..f80dfc5
--- /dev/null
+++ b/test/qa-issue-003-order-isolation.test.mjs
@@ -0,0 +1,30 @@
+import assert from 'node:assert/strict';
+import { after, before, describe, it } from 'node:test';
+import { startTestApp } from './helpers.mjs';
+
+describe('QA ISSUE-003: order detail is limited to the caller\'s company', () => {
+  let t;
+  let orderId;
+  before(async () => {
+    t = await startTestApp();
+    const created = await t.call('POST', '/api/orders', {
+      token: await t.login('acme1'),
+      body: { reference: 'QA-iso', items: [{ product_id: 'p-101', quantity: 1 }] },
+    });
+    orderId = created.json.id;
+  });
+  after(() => t.close());
+
+  it('hides another company\'s order from a client', async () => {
+    const res = await t.call('GET', `/api/orders/${orderId}`, { token: await t.login('bright1') });
+    assert.equal(res.status, 404);
+  });
+
+  it('still shows the order to the same company, a colleague and an admin', async () => {
+    for (const account of ['acme1', 'acme2', 'admin']) {
+      const res = await t.call('GET', `/api/orders/${orderId}`, { token: await t.login(account) });
+      assert.equal(res.status, 200, account);
+      assert.equal(res.json.id, orderId);
+    }
+  });
+});
