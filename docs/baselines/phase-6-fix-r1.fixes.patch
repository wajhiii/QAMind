diff --git a/test/customers-access.test.mjs b/test/customers-access.test.mjs
new file mode 100644
index 0000000..def770b
--- /dev/null
+++ b/test/customers-access.test.mjs
@@ -0,0 +1,21 @@
+import assert from 'node:assert/strict';
+import { after, before, describe, it } from 'node:test';
+import { startTestApp } from './helpers.mjs';
+
+describe('customer list access', () => {
+  let t;
+  before(async () => { t = await startTestApp(); });
+  after(() => t.close());
+
+  it('forbids client users from listing customers', async () => {
+    const res = await t.call('GET', '/api/admin/customers', { token: await t.login('acme1') });
+    assert.equal(res.status, 403);
+    assert.equal(res.json.error.code, 'forbidden');
+  });
+
+  it('still lists customers for admins', async () => {
+    const res = await t.call('GET', '/api/admin/customers', { token: await t.login('admin') });
+    assert.equal(res.status, 200);
+    assert.ok(res.json.items.length > 0);
+  });
+});
diff --git a/test/logout-session.test.mjs b/test/logout-session.test.mjs
new file mode 100644
index 0000000..0d4b8d0
--- /dev/null
+++ b/test/logout-session.test.mjs
@@ -0,0 +1,25 @@
+import assert from 'node:assert/strict';
+import { after, before, describe, it } from 'node:test';
+import { startTestApp } from './helpers.mjs';
+
+describe('sign-out ends the session', () => {
+  let t;
+  before(async () => { t = await startTestApp(); });
+  after(() => t.close());
+
+  it('rejects a token after logout and leaves other sessions alone', async () => {
+    const token = await t.login('zain1');
+    const other = await t.login('acme1');
+    assert.equal((await t.call('GET', '/api/me', { token })).status, 200);
+    assert.equal((await t.call('POST', '/api/auth/logout', { token })).status, 204);
+    const after = await t.call('GET', '/api/me', { token });
+    assert.equal(after.status, 401);
+    assert.equal((await t.call('GET', '/api/me', { token: other })).status, 200);
+  });
+
+  it('rejects an expired session', async () => {
+    const token = await t.login('acme2');
+    t.app.store.sessions.get(token).expiresAt = Date.now() - 1000;
+    assert.equal((await t.call('GET', '/api/me', { token })).status, 401);
+  });
+});
