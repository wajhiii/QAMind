diff --git a/test/order-search.test.mjs b/test/order-search.test.mjs
new file mode 100644
index 0000000..1d07d86
--- /dev/null
+++ b/test/order-search.test.mjs
@@ -0,0 +1,32 @@
+import assert from 'node:assert/strict';
+import { after, before, describe, it } from 'node:test';
+import { startTestApp } from './helpers.mjs';
+
+describe('order search text', () => {
+  let t;
+  before(async () => { t = await startTestApp(); });
+  after(() => t.close());
+
+  it('treats special characters as plain text', async () => {
+    const token = await t.login('acme1');
+    const created = await t.call('POST', '/api/orders', {
+      token,
+      body: { reference: 'QA-(a+b)', items: [{ product_id: 'p-101', quantity: 1 }] },
+    });
+    assert.equal(created.status, 201);
+    for (const q of ['(', '[', '\\', '*', '+']) {
+      const res = await t.call('GET', `/api/orders?q=${encodeURIComponent(q)}`, { token });
+      assert.equal(res.status, 200, `q=${q}`);
+    }
+    const hit = await t.call('GET', `/api/orders?q=${encodeURIComponent('(a+b)')}`, { token });
+    assert.equal(hit.json.total, 1);
+    assert.equal(hit.json.items[0].reference, 'QA-(a+b)');
+    const noPatternMatch = await t.call('GET', `/api/orders?q=${encodeURIComponent('QA-.*')}`, { token });
+    assert.equal(noPatternMatch.json.total, 0);
+  });
+
+  it('still searches plain text case-insensitively', async () => {
+    const res = await t.call('GET', '/api/orders?q=bf-22', { token: await t.login('admin') });
+    assert.ok(res.json.items.length >= 3);
+  });
+});
diff --git a/test/order-validation.test.mjs b/test/order-validation.test.mjs
new file mode 100644
index 0000000..b1ec0c1
--- /dev/null
+++ b/test/order-validation.test.mjs
@@ -0,0 +1,28 @@
+import assert from 'node:assert/strict';
+import { after, before, describe, it } from 'node:test';
+import { startTestApp } from './helpers.mjs';
+
+describe('order quantity validation', () => {
+  let t;
+  before(async () => { t = await startTestApp(); });
+  after(() => t.close());
+
+  const place = async (quantity) => t.call('POST', '/api/orders', {
+    token: await t.login('acme1'),
+    body: { reference: 'QA-qty', items: [{ product_id: 'p-101', quantity }] },
+  });
+
+  for (const quantity of [-3, 0, 1.5, 1001]) {
+    it(`refuses quantity ${quantity}`, async () => {
+      const res = await place(quantity);
+      assert.equal(res.status, 400);
+      assert.equal(res.json.error.details[0].field, 'items[0].quantity');
+    });
+  }
+
+  for (const quantity of [1, 1000]) {
+    it(`accepts quantity ${quantity}`, async () => {
+      assert.equal((await place(quantity)).status, 201);
+    });
+  }
+});
