+    });
+    assert.equal(res.status, 201);
+  });
+});
diff --git a/test/order-freshness.test.mjs b/test/order-freshness.test.mjs
new file mode 100644
index 0000000..16d624f
--- /dev/null
+++ b/test/order-freshness.test.mjs
@@ -0,0 +1,26 @@
+import assert from 'node:assert/strict';
+import { after, before, describe, it } from 'node:test';
+import { startTestApp } from './helpers.mjs';
+
+describe('order list freshness', () => {
+  let t;
+  before(async () => { t = await startTestApp(); });
+  after(() => t.close());
+
+  it('shows a status change made by an admin after the list was already read', async () => {
+    const client = await t.login('acme1');
+    const admin = await t.login('admin');
+    const created = await t.call('POST', '/api/orders', {
+      token: client,
+      body: { reference: 'QA-fresh', items: [{ product_id: 'p-101', quantity: 1 }] },
+    });
+    const first = await t.call('GET', '/api/orders?q=QA-fresh', { token: client });
+    assert.equal(first.json.items[0].status, 'placed');
+    const moved = await t.call('PATCH', `/api/admin/orders/${created.json.id}/status`, { token: admin, body: { status: 'processing' } });
+    assert.equal(moved.status, 200);
+    const second = await t.call('GET', '/api/orders?q=QA-fresh', { token: client });
+    assert.equal(second.json.items[0].status, 'processing');
+    const colleague = await t.call('GET', '/api/orders?q=QA-fresh', { token: await t.login('acme2') });
+    assert.equal(colleague.json.items[0].status, 'processing');
+  });
+});
diff --git a/test/order-isolation.test.mjs b/test/order-isolation.test.mjs
new file mode 100644
index 0000000..67adb94
--- /dev/null
+++ b/test/order-isolation.test.mjs
@@ -0,0 +1,31 @@
+import assert from 'node:assert/strict';
+import { after, before, describe, it } from 'node:test';
+import { startTestApp } from './helpers.mjs';
+
+describe('order detail isolation', () => {
+  let t;
+  before(async () => { t = await startTestApp(); });
+  after(() => t.close());
+
+  it('hides another company\'s order from a client', async () => {
+    const created = await t.call('POST', '/api/orders', {
+      token: await t.login('acme1'),
+      body: { reference: 'QA-iso', items: [{ product_id: 'p-101', quantity: 1 }] },
+    });
+    assert.equal(created.status, 201);
+    const res = await t.call('GET', `/api/orders/${created.json.id}`, { token: await t.login('bright1') });
+    assert.equal(res.status, 404);
+    assert.equal(res.json.error.code, 'not_found');
+  });
+
+  it('still lets a colleague and an admin read the order', async () => {
+    const created = await t.call('POST', '/api/orders', {
+      token: await t.login('acme1'),
+      body: { reference: 'QA-iso-2', items: [{ product_id: 'p-101', quantity: 1 }] },
+    });
+    const colleague = await t.call('GET', `/api/orders/${created.json.id}`, { token: await t.login('acme2') });
+    assert.equal(colleague.status, 200);
+    const admin = await t.call('GET', `/api/orders/${created.json.id}`, { token: await t.login('admin') });
+    assert.equal(admin.status, 200);
+  });
+});
