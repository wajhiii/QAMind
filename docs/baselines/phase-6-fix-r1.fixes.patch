+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+import { priceOrder } from '../src/pricing.mjs';
+
+const products = new Map([
+  ['p-102', { id: 'p-102', name: 'Ballpoint Pens, box of 50', price_cents: 1250 }],
+  ['p-105', { id: 'p-105', name: 'Desk Organizer', price_cents: 2450 }],
+]);
+
+describe('priceOrder tax', () => {
+  it('applies tax to the discounted subtotal at exactly 1000.00', () => {
+    const priced = priceOrder([{ product_id: 'p-102', quantity: 80 }], products);
+    assert.equal(priced.subtotal_cents, 100000);
+    assert.equal(priced.discount_cents, 5000);
+    assert.equal(priced.tax_cents, 9500);
+    assert.equal(priced.total_cents, 104500);
+  });
+
+  it('rounds tax on the discounted subtotal to the cent', () => {
+    const priced = priceOrder([{ product_id: 'p-105', quantity: 41 }], products);
+    assert.equal(priced.discount_cents, 5023);
+    assert.equal(priced.tax_cents, 9543);
+    assert.equal(priced.total_cents, 104970);
+  });
+
+  it('taxes the full subtotal when there is no discount', () => {
+    const priced = priceOrder([{ product_id: 'p-102', quantity: 79 }], products);
+    assert.equal(priced.discount_cents, 0);
+    assert.equal(priced.tax_cents, 9875);
+    assert.equal(priced.total_cents, 108625);
+  });
+});