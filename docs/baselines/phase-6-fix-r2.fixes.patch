index 0000000..4d0fdd1
--- /dev/null
+++ b/test/regression-session-end.test.mjs
@@ -0,0 +1,31 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+import { startTestApp } from './helpers.mjs';
+
+describe('sessions end at sign-out and at expiry', () => {
+  it('rejects the same token everywhere once the user has signed out', async () => {
+    const t = await startTestApp();
+    try {
+      const token = await t.login('zain1');
+      assert.equal((await t.call('GET', '/api/me', { token })).status, 200);
+      assert.equal((await t.call('POST', '/api/auth/logout', { token })).status, 204);
+      assert.equal((await t.call('GET', '/api/me', { token })).status, 401);
+      assert.equal((await t.call('GET', '/api/orders', { token })).status, 401);
+      assert.equal((await t.call('POST', '/api/auth/logout', { token })).status, 401);
+      const fresh = await t.login('zain1');
+      assert.equal((await t.call('GET', '/api/me', { token: fresh })).status, 200);
+    } finally {
+      await t.close();
+    }
+  });
+
+  it('rejects a token whose session has expired', async () => {
+    const t = await startTestApp({ sessionTtlSeconds: -1 });
+    try {
+      const token = await t.login('acme1');
+      assert.equal((await t.call('GET', '/api/me', { token })).status, 401);
+    } finally {
+      await t.close();
+    }
+  });
+});
