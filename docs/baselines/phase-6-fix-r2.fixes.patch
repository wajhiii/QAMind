diff --git a/test/regression-customers-admin-only.test.mjs b/test/regression-customers-admin-only.test.mjs
new file mode 100644
index 0000000..76e6fb4
--- /dev/null
+++ b/test/regression-customers-admin-only.test.mjs
@@ -0,0 +1,24 @@
+import assert from 'node:assert/strict';
+import { after, before, describe, it } from 'node:test';
+import { startTestApp } from './helpers.mjs';
+
+describe('customers list is admin only', () => {
+  let t;
+  before(async () => { t = await startTestApp(); });
+  after(() => t.close());
+
+  it('refuses every client user and anonymous callers', async () => {
+    for (const account of ['acme1', 'acme2', 'bright1', 'zain1']) {
+      const res = await t.call('GET', '/api/admin/customers', { token: await t.login(account) });
+      assert.equal(res.status, 403, `${account} must be refused`);
+      assert.equal(res.json.items, undefined);
+    }
+    assert.equal((await t.call('GET', '/api/admin/customers')).status, 401);
+  });
+
+  it('still lists customers for an admin', async () => {
+    const res = await t.call('GET', '/api/admin/customers', { token: await t.login('admin') });
+    assert.equal(res.status, 200);
+    assert.ok(res.json.items.length > 0);
+  });
+});
diff --git a/test/regression-fresh-status.test.mjs b/test/regression-fresh-status.test.mjs
new file mode 100644
index 0000000..77a31d1
--- /dev/null
+++ b/test/regression-fresh-status.test.mjs
@@ -0,0 +1,36 @@
+import assert from 'node:assert/strict';
+import { after, before, describe, it } from 'node:test';
+import { startTestApp } from './helpers.mjs';
+
+describe('client order list shows an admin\'s status change at once', () => {
+  let t;
+  before(async () => { t = await startTestApp(); });
+  after(() => t.close());
+
+  it('re-reads the status after warming the list', async () => {
+    const client = await t.login('bright1');
+    const admin = await t.login('admin');
+    const created = await t.call('POST', '/api/orders', {
+      token: client,
+      body: { reference: 'QA-fresh', items: [{ product_id: 'p-101', quantity: 1 }] },
+    });
+    const id = created.json.id;
+    const warm = await t.call('GET', '/api/orders?q=QA-fresh', { token: client });
+    assert.equal(warm.json.items[0].status, 'placed');
+
+    const change = await t.call('PATCH', `/api/admin/orders/${id}/status`, { token: admin, body: { status: 'processing' } });
+    assert.equal(change.status, 200);
+
+    const list = await t.call('GET', '/api/orders?q=QA-fresh', { token: client });
+    assert.equal(list.json.items[0].status, 'processing');
+    const filtered = await t.call('GET', '/api/orders?status=processing&q=QA-fresh', { token: client });
+    assert.equal(filtered.json.total, 1);
+    const detail = await t.call('GET', `/api/orders/${id}`, { token: client });
+    assert.equal(detail.json.status, 'processing');
+  });
+
+  it('still limits the list to the caller\'s company', async () => {
+    const res = await t.call('GET', '/api/orders?page_size=100', { token: await t.login('acme1') });
+    assert.ok(res.json.items.every((order) => order.client_id === 'c-acme'));
+  });
+});
diff --git a/test/regression-no-stack-leak.test.mjs b/test/regression-no-stack-leak.test.mjs
new file mode 100644
index 0000000..fc94079
--- /dev/null
+++ b/test/regression-no-stack-leak.test.mjs
@@ -0,0 +1,32 @@
+import assert from 'node:assert/strict';
+import { after, before, describe, it } from 'node:test';
+import { startTestApp } from './helpers.mjs';
+
+describe('malformed JSON errors reveal no internals', () => {
+  let t;
+  before(async () => { t = await startTestApp(); });
+  after(() => t.close());
+
+  function assertClean(res) {
+    assert.equal(res.status, 400);
+    assert.equal(res.json.error.code, 'invalid_json');
+    assert.equal(typeof res.json.error.message, 'string');
+    assert.equal(res.json.error.trace, undefined);
+    assert.equal(res.json.error.stack, undefined);
+    assert.doesNotMatch(res.text, /\n\s+at |\.mjs|node:internal|\/Users\/|\/var\/|\/home\//);
+  }
+
+  it('login with a broken body returns a short message', async () => {
+    assertClean(await t.call('POST', '/api/auth/login', { body: '{not json', raw: true }));
+  });
+
+  it('placing an order with a broken body returns a short message', async () => {
+    const token = await t.login('acme1');
+    assertClean(await t.call('POST', '/api/orders', { token, body: '{"reference": ', raw: true }));
+  });
+
+  it('a valid body is still read normally', async () => {
+    const res = await t.call('POST', '/api/auth/login', { body: { email: 'nobody@acme.test', password: 'x' } });
+    assert.equal(res.status, 401);
+  });
+});
diff --git a/test/regression-order-isolation.test.mjs b/test/regression-order-isolation.test.mjs
new file mode 100644
index 0000000..37fedcb
--- /dev/null
+++ b/test/regression-order-isolation.test.mjs
@@ -0,0 +1,25 @@
+import assert from 'node:assert/strict';
+import { after, before, describe, it } from 'node:test';
+import { startTestApp } from './helpers.mjs';
+
+describe('order access by id (company isolation)', () => {
+  let t;
+  before(async () => { t = await startTestApp(); });
+  after(() => t.close());
+
+  it('hides another company\'s order from a client', async () => {
+    const acme = await t.call('GET', '/api/orders/o-1001', { token: await t.login('acme1') });
+    assert.equal(acme.status, 200);
+    const bright = await t.call('GET', '/api/orders/o-1001', { token: await t.login('bright1') });
+    assert.equal(bright.status, 404);
+    const zain = await t.call('GET', '/api/orders/o-1001', { token: await t.login('zain1') });
+    assert.equal(zain.status, 404);
+  });
+
+  it('still lets colleagues of the same company and admins open the order', async () => {
+    const colleague = await t.call('GET', '/api/orders/o-1001', { token: await t.login('acme2') });
+    assert.equal(colleague.status, 200);
+    const admin = await t.call('GET', '/api/orders/o-1001', { token: await t.login('admin') });
+    assert.equal(admin.status, 200);
+  });
+});
diff --git a/test/regression-order-quantity.test.mjs b/test/regression-order-quantity.test.mjs
new file mode 100644
index 0000000..eb375a4
--- /dev/null
+++ b/test/regression-order-quantity.test.mjs
@@ -0,0 +1,42 @@
+import assert from 'node:assert/strict';
+import { after, before, describe, it } from 'node:test';
+import { startTestApp } from './helpers.mjs';
+
+describe('order quantity and item rules', () => {
+  let t;
+  let token;
+  before(async () => {
+    t = await startTestApp();
+    token = await t.login('acme1');
+  });
+  after(() => t.close());
+
+  const order = (items) => t.call('POST', '/api/orders', { token, body: { reference: 'QA-qty', items } });
+
+  it('refuses quantities that are negative, zero, too large or fractional', async () => {
+    for (const quantity of [-3, 0, 1001, 1.5]) {
+      const res = await order([{ product_id: 'p-101', quantity }]);
+      assert.equal(res.status, 400, `quantity ${quantity} must be refused`);
+      assert.equal(res.json.error.details[0].field, 'items[0].quantity');
+    }
+  });
+
+  it('refuses an order with no items', async () => {
+    const res = await order([]);
+    assert.equal(res.status, 400);
+    assert.equal(res.json.error.details[0].field, 'items');
+  });
+
+  it('refuses a bad line even when other lines are fine, and stores nothing', async () => {
+    const before = (await t.call('GET', '/api/orders?page_size=100', { token })).json.total;
+    const res = await order([{ product_id: 'p-101', quantity: 2 }, { product_id: 'p-102', quantity: -1 }]);
+    assert.equal(res.status, 400);
+    const after = (await t.call('GET', '/api/orders?page_size=100', { token })).json.total;
+    assert.equal(after, before);
+  });
+
+  it('accepts the smallest and largest allowed quantities', async () => {
+    assert.equal((await order([{ product_id: 'p-101', quantity: 1 }])).status, 201);
+    assert.equal((await order([{ product_id: 'p-104', quantity: 1000 }])).status, 201);
+  });
+});
diff --git a/test/regression-order-search.test.mjs b/test/regression-order-search.test.mjs
new file mode 100644
index 0000000..7f62773
--- /dev/null
+++ b/test/regression-order-search.test.mjs
@@ -0,0 +1,40 @@
+import assert from 'node:assert/strict';
+import { after, before, describe, it } from 'node:test';
+import { startTestApp } from './helpers.mjs';
+
+describe('order search treats the text literally', () => {
+  let t;
+  let token;
+  before(async () => {
+    t = await startTestApp();
+    token = await t.login('acme1');
+    const res = await t.call('POST', '/api/orders', {
+      token,
+      body: { reference: 'QA-(a)[b]\\c.d', items: [{ product_id: 'p-101', quantity: 1 }] },
+    });
+    assert.equal(res.status, 201);
+  });
+  after(() => t.close());
+
+  it('does not fail on regular-expression characters', async () => {
+    for (const q of ['(', ')', '[', '\\', '*', '+', '?']) {
+      const res = await t.call('GET', `/api/orders?q=${encodeURIComponent(q)}`, { token });
+      assert.equal(res.status, 200, `q=${q} must not fail`);
+    }
+  });
+
+  it('finds an order whose reference contains those characters', async () => {
+    const res = await t.call('GET', `/api/orders?q=${encodeURIComponent('(a)[b]\\c.d')}`, { token });
+    assert.equal(res.status, 200);
+    assert.equal(res.json.total, 1);
+  });
+
+  it('does not treat a dot as a wildcard, and stays case-insensitive', async () => {
+    const wildcard = await t.call('GET', `/api/orders?q=${encodeURIComponent('c.d')}`, { token });
+    assert.equal(wildcard.json.total, 1);
+    const noMatch = await t.call('GET', `/api/orders?q=${encodeURIComponent('c-d')}`, { token });
+    assert.equal(noMatch.json.total, 0);
+    const upper = await t.call('GET', '/api/orders?q=PO-44', { token });
+    assert.ok(upper.json.total >= 1);
+  });
+});
