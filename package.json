{
  "name": "qamind",
  "version": "0.1.0",
  "private": true,
  "description": "QAMind: a reusable Senior QA Engineer agent for AI coding tools (Claude Code first). Distributed from Git only.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "check:generated": "node scripts/build.ts --check",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-reporter=spec \"tests/core/**/*.test.ts\"",
    "validate": "node scripts/validate-plugin.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "yaml": "2.9.1"
  }
}
